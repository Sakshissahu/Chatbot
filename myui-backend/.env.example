# Copy to .env (gitignored) and fill in the secrets.
PORT=8088

# --- Postgres (also consumed by docker-compose.yml for the container) ---
# Pick your own credentials; they are created inside the dedicated container.
POSTGRES_USER=ibchat
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=ibchat
POSTGRES_PORT=5442
DATABASE_URL=postgres://ibchat:change-me-to-a-long-random-string@localhost:5442/ibchat

# --- RAGFlow upstream ---
# RAGFLOW_BETA_TOKEN is a RAGFlow "beta" token (POST /api/v1/system/tokens).
# `python ../myui/scripts/setup_and_probe.py` can mint it and write it here.
RAGFLOW_BASE_URL=http://localhost:80
RAGFLOW_BETA_TOKEN=your-ragflow-beta-token
FARMER_BOT_ID=66824bb2675f11f1bb5ca9173f52da2e
EMPLOYEE_BOT_ID=2150f758676111f1bb5ca9173f52da2e

# --- CORS ---
# Comma-separated allow-list of browser origins. A single `*` matches one host
# label, so `https://*.vercel.app` accepts any Vercel deploy/preview URL.
# Local dev reaches the backend same-origin via the Vite /bff proxy (no CORS);
# the deployed demo reaches it cross-origin from Vercel through the tunnel.
# Lock down to one exact domain by replacing the wildcard, e.g.
#   ALLOWED_ORIGIN=https://ib-group-chat.vercel.app
# (CORS_ORIGIN is still read as a fallback if ALLOWED_ORIGIN is unset.)
ALLOWED_ORIGIN=http://localhost:5173,https://*.vercel.app
