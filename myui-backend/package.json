{
  "name": "ib-group-chat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BFF between the IB Group brand UI and RAGFlow. Logs every Q&A to Postgres and persists chat history.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:logs": "docker compose logs -f ibchat-postgres"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
